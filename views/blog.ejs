<% layout('layout') -%>
<div class="container">
  <h2>Blog</h2>
  <% posts.forEach(p=>{ %>
    <article class="post-summary">
      <h3><a href="/blog/<%= p.slug %>"><%= p.title %></a></h3>
      <p><small><%= new Date(p.created_at).toLocaleDateString() %></small></p>
      <p><%= (p.content || '').slice(0,200) %>...</p>
    </article>
  <% }) %>
</div>
